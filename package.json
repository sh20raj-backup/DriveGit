{
  "name": "drivegit",
  "version": "0.1.0",
  "description": "Local-first version control for any folder, with Google Drive remotes planned.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "bin": { "drivegit": "./dist/index.js" },
  "files": ["dist", "README.md", "docs"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "ignore": "^7.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
